/* 1. Atur ukuran bungkusan scrollbar */
::-webkit-scrollbar {
    width: 8px;
    height: 6px;
}

/* 2. Atur warna rel lintasannya */
::-webkit-scrollbar-track {
    background-color: rgba(255, 255, 255, 0.046); /* Hitam pekat */

}

/* 3. Atur bentuk batang penggesernya */
::-webkit-scrollbar-thumb {
    background-color: rgba(104, 107, 255, 0.361); /* Warna Indigo */
    border-radius: 5px;        /* Membuat ujung batangnya membulat estetik */
    border: none; /* Memberi efek jarak (gap) antara batang dan rel */
}

/* 4. Sembunyikan tombol panah bawaan yang mengganggu */
::-webkit-scrollbar-button {
    display: none;
}
